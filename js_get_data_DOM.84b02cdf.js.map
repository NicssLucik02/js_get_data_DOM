var elements = document.querySelectorAll('.population');
var total = document.querySelector('.total-population');
var average = document.querySelector('.average-population');
var arr = [];
for(var i = 0; i < elements.length; i++)arr.push(elements[i].textContent);
var totalPopulation = arr.map(function(num) {
    return Number(num.replace(/,/g, ''));
}).reduce(function(acc, curr) {
    return acc + curr;
});
var avgPopulation = totalPopulation / arr.length;
total.textContent = totalPopulation.toLocaleString('En-US');
average.textContent = Math.floor(avgPopulation).toLocaleString('En-US');

